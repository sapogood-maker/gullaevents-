# Node Environment
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://gulla_user:gulla_password@localhost:5432/gulla_events
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=gulla_user
DB_PASSWORD=gulla_password
DB_DATABASE=gulla_events

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=24h

# QR Code
QR_SECRET_KEY=your-super-secret-qr-key-change-in-production-min-32-chars

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:8080,http://localhost:5173

# Logging
LOG_LEVEL=debug

# Payment Gateway (Future Integration)
PIX_PROVIDER=celcoin
PIX_API_KEY=your-pix-api-key
PIX_WEBHOOK_SECRET=your-webhook-secret
